# API key của Anthropic (dùng để dịch văn bản) - lấy tại https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Chọn nhà cung cấp TTS: "elevenlabs" hoặc "google"
TTS_PROVIDER=elevenlabs

# API key ElevenLabs (nếu dùng elevenlabs) - lấy tại https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Đường dẫn file credentials JSON của Google Cloud (nếu dùng google TTS)
GOOGLE_APPLICATION_CREDENTIALS=path/to/google-credentials.json
